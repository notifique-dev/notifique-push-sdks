{
  "name": "@notifique/push",
  "version": "0.2.0",
  "description": "Official Notifique Web Push SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs,iife --global-name NotifiquePushBundle --dts --clean",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "notifique",
    "push",
    "web-push",
    "vapid"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/notifique/notifique-push-sdks.git",
    "directory": "packages/web"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
