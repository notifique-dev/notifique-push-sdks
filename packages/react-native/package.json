{
  "name": "@notifique/push-react-native",
  "version": "0.1.0",
  "private": false,
  "description": "Official Notifique React Native SDK for push notifications",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "notifique",
    "push",
    "react-native",
    "fcm",
    "apns"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/notifique/notifique-push-sdks.git",
    "directory": "packages/react-native"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.test.ts"
    ]
  }
}
